{
  "name": "matter-switchboard",
  "version": "1.0.0",
  "description": "A local Matter controller and HTTP power-switch API",
  "license": "MIT",
  "author": "sam0737",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sam0737/matter-switchboard.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "matter-switchboard": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js server",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "npm run build && node --test dist/test/unit/*.test.js",
    "test:e2e": "npm run build && node --test dist/test/e2e/*.test.js"
  },
  "dependencies": {
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@matter/main": "0.17.9",
    "@matter/protocol": "0.17.9",
    "@project-chip/matter.js": "0.17.9",
    "commander": "^14.0.0",
    "fastify": "^5.3.3",
    "ink": "^7.1.1",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "eslint": "^10.11.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.1"
  }
}

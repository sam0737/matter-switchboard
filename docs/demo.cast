[0.012, "o", "\u001b[1mMatter Switchboard\u001b(B\u001b[m \u001b[32mlive\r\n\u001b(B\u001b[m\u001b[2mNo devices. Press c to configure (add a mock or commission a strip).\u001b[12;1H\u001b(B\u001b[m\u001b[36m\u001b[1menter\u001b(B\u001b[m\u001b[2m toggle\u001b(B\u001b[m   \u001b[36m\u001b[1mc\u001b(B\u001b[m\u001b[2m configure\u001b(B\u001b[m   \u001b[33m\u001b[1mq\u001b(B\u001b[m\u001b[2m quit\r\n\u001b(B\u001b[m"]
